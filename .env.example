# Copy this file to .env and replace <password> with the password assigned to task_helper.
# URL-encode special characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql://task_helper:<password>@127.0.0.1:5433/task_helper_dev
DATABASE_SSL=false
GIGACHAT_CREDENTIALS=<authorization-key>
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Base64-encoded contents of the authorized-key JSON file for the Yandex Cloud service account.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes('C:\secure\service-account-key.json'))
YANDEX_TRACKER_SERVICE_ACCOUNT_KEY=<base64-encoded-authorized-key-json>
# Federation organization. This value is already the organization provided for this deployment.
YANDEX_TRACKER_ORG_ID=bpf7jl9ghb35o2idt8iq
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
